# /etc/lidar-auth.env  (chmod 640, owner root:admin)
# All values are optional; the defaults are for local development.
NODE_ENV=production
AUTH_HOST=0.0.0.0
AUTH_PORT=8080
AUTH_DB_PATH=/home/admin/lidar-robot/lidar-robot/robot/data/auth.db
WEB_ROOT=/home/admin/lidar-robot/lidar-robot/web/public
# PUBLIC_ORIGIN: hagyd üresen, ha az IP DHCP-vel változhat - ilyenkor a Host
# headerből deriváljuk (ez a Pi-n bevált beállítás). Csak fix címnél írd be
# pontosan (séma + host + port), pl. http://192.168.1.22:8080, különben a
# POST-ok 403 forbidden_origin-t kapnak.
PUBLIC_ORIGIN=
# ALLOW_REGISTRATION=0: csak admin CLI-vel lehet fiokot letrehozni (a Pi-n ez az
# ajanlott). 1 = onregisztracio a web UI-bol, LAN-on (10 regisztracio / IP / ora).
ALLOW_REGISTRATION=0
COOKIE_SECURE=0
TRUST_PROXY=0
LOG_LEVEL=info
