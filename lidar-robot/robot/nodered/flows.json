    {
        "id": "sqlite_get_home",
        "type": "sqlite",
        "z": "tab_robot_core",
        "mydb": "sqlite_robot_db",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Aktív Bázispont Lekérése",
        "x": 540,
        "y": 200,
        "wires": [
            [
                "func_build_goal_pose"
            ]
        ]
    },
    {
        "id": "func_build_goal_pose",
        "type": "function",
        "z": "tab_robot_core",
        "name": "/goal_pose JSON & Log építése",
        "func": "if (!msg.payload || msg.payload.length === 0) {\n    node.warn(\"Nincs aktív térkép az adatbázisban!\");\n    return null;\n}\n\nconst activeMap = msg.payload[0];\nconst x = activeMap.home_x;\nconst y = activeMap.home_y;\nconst theta = activeMap.home_theta;\n\n// 1. kimenet: rosbridge /goal_pose (geometry_msgs/msg/PoseStamped)\nconst rosMsg = {\n    op: \"publish\",\n    topic: \"/goal_pose\",\n    type: \"geometry_msgs/msg/PoseStamped\",\n    msg: {\n        header: {\n            frame_id: \"map\"\n        },\n        pose: {\n            position: { x: x, y: y, z: 0.0 },\n            orientation: {\n                x: 0.0,\n                y: 0.0,\n                z: Math.sin(theta / 2.0),\n                w: Math.cos(theta / 2.0)\n            }\n        }\n    }\n};\n\n// 2. kimenet: Naplózás a system_logs táblába\nconst logMsg = {\n    topic: `INSERT INTO system_logs (level, source, message) VALUES ('INFO', 'nodered', 'Go Home indítva a (${x}, ${y}) bázispontra (${activeMap.map_name})');`\n};\n\nreturn [ { payload: JSON.stringify(rosMsg) }, logMsg ];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 200,
        "wires": [
            [
                "ws_out_rosbridge",
                "debug_db_out",
                "func_go_home_response"
            ],
            [
                "sqlite_log_insert"
            ]
        ]
    },
