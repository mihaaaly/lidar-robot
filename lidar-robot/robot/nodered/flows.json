    {
        "id": "func_go_home_response",
        "type": "function",
        "z": "tab_robot_core",
        "name": "Go Home HTTP válasz építése",
        "func": "let target = { x: 0, y: 0 };\ntry {\n    const rosMsg = JSON.parse(msg.payload);\n    if (rosMsg && rosMsg.msg && rosMsg.msg.pose && rosMsg.msg.pose.position) {\n        target = { x: rosMsg.msg.pose.position.x, y: rosMsg.msg.pose.position.y };\n    }\n} catch (e) {}\nmsg.payload = { status: \"ok\", target: target };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
